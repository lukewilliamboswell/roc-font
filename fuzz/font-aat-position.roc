app [target] {
	build: "../tests/support/main.roc",
	font: "../package/main.roc",
	fuzz: platform "https://github.com/lukewilliamboswell/roc-fuzz/releases/download/0.4.3/41NK5FShyGC9Z8HNpUdUeXMWwLmLNfFxsfmLvdPL4Fxb.tar.zst",
}
import fuzz.Fuzz
import font.Font
import build.FontBuild
import "../tests/fonts/aat-position/kerx0-size-8.ttf" as small_file : List(U8)
import "../tests/fonts/aat-position/kerx0-size-64.ttf" as middle_file : List(U8)
import "../tests/fonts/aat-position/kerx0-size-256.ttf" as large_file : List(U8)
import "../tests/fonts/aat-position/kerx1.ttf" as state_file : List(U8)
import "../tests/fonts/aat-position/kerx1-cycle.ttf" as cycle_file : List(U8)
import "../tests/fonts/aat-position/kerx1-cross.ttf" as cross_file : List(U8)
import "../tests/fonts/aat-position/kerx4-anchor.ttf" as anchor_file : List(U8)
import "../tests/fonts/aat-position/kerx4-point-variable.ttf" as point_file : List(U8)
import "../tests/fonts/aat-position/kerx4-chain.ttf" as chain_file : List(U8)
import "../tests/fonts/aat-position/kerx6-long-tuple.ttf" as matrix_file : List(U8)
import "../tests/fonts/aat-position/Jellee-Roman.ttf" as real_file : List(U8)

## Pair data at 8/64/256 records has linear reading allocations and
## constant two-glyph query allocations. Stateful work at 8/64/256 text
## repetitions stays index aligned, deterministic and within the work
## budget. Epsilon cycles return explicit partial progress. Corrupted
## real/generated bytes never bypass preparation or leak allocations.
test! : List(U8) => Fuzz.Outcome
test! = |bytes| {
	a = ready(small_file)
	b = ready(middle_file)
	c = ready(large_file)
	options = Font.ShapeOptions.{ script: "Latn", language: "en" }
	pa = Font.plan(a, options)
	pb = Font.plan(b, options)
	pc = Font.plan(c, options)
	ra = Fuzz.measure_allocs!(|{}| Font.from_bytes(small_file, Font.ReadOptions.{}))
	rb = Fuzz.measure_allocs!(|{}| Font.from_bytes(middle_file, Font.ReadOptions.{}))
	rc = Fuzz.measure_allocs!(|{}| Font.from_bytes(large_file, Font.ReadOptions.{}))
	if rb.allocations > ra.allocations * 10 + 128 or rc.allocations > rb.allocations * 6 + 128 {
		crash "AAT pair reading allocations exceeded linear size growth"
	}
	qa = Fuzz.measure_allocs!(|{}| Font.shape_planned(a, pa, "ab"))
	qb = Fuzz.measure_allocs!(|{}| Font.shape_planned(b, pb, "ab"))
	qc = Fuzz.measure_allocs!(|{}| Font.shape_planned(c, pc, "ab"))
	if qb.allocations > qa.allocations + 2 or qc.allocations > qa.allocations + 2 {
		crash "AAT pair query allocated in unrelated pair count"
	}
	if qa.value.advances != [{ x: 484, y: 0 }, { x: 485, y: 0 }] or qb.value.advances != [{ x: 484, y: 0 }, { x: 485, y: 0 }] or qc.value.advances != [{ x: 484, y: 0 }, { x: 515, y: 0 }] {
		crash "AAT pair split or glyph alignment changed"
	}
	state = ready(state_file)
	plan = Font.plan(state, options)
	short = Str.join_with(List.repeat("ab", 8), "")
	middle = Str.join_with(List.repeat("ab", 64), "")
	long = Str.join_with(List.repeat("ab", 256), "")
	x = Fuzz.measure_allocs!(|{}| Font.shape_planned(state, plan, short))
	y = Fuzz.measure_allocs!(|{}| Font.shape_planned(state, plan, middle))
	z = Fuzz.measure_allocs!(|{}| Font.shape_planned(state, plan, long))
	if y.allocations > x.allocations + 2 or z.allocations > x.allocations + 2 {
		crash "AAT state shaping allocated per state action"
	}
	check(state, short, options, x.value)
	check(state, middle, options, y.value)
	check(state, long, options, z.value)
	anchor = ready(anchor_file)
	anchor_plan = Font.plan(anchor, options)
	ax = Fuzz.measure_allocs!(|{}| Font.shape_planned(anchor, anchor_plan, short))
	ay = Fuzz.measure_allocs!(|{}| Font.shape_planned(anchor, anchor_plan, middle))
	az = Fuzz.measure_allocs!(|{}| Font.shape_planned(anchor, anchor_plan, long))
	if ay.allocations > ax.allocations + 2 or az.allocations > ax.allocations + 2 {
		crash "AAT attachments allocated per state action"
	}
	check(anchor, short, options, ax.value)
	check(anchor, middle, options, ay.value)
	check(anchor, long, options, az.value)
	Fuzz.expect_no_leaks!(|{}| Font.shape_planned(state, plan, long))
	choice = (bytes.first() ?? 0).to_u64()
	if choice % 16 == 7 {
		cycle = ready(cycle_file)
		cycle_text = if (bytes.len() % 2 == 0) "ab" else "abab"
		match Font.shape_checked(cycle, Font.plan(cycle, options), cycle_text) {
			Err(OverBudget(r)) => if r.run.glyphs.len() != cycle_text.to_utf8().len() or !r.budgets.contains(Operations) {
				crash "AAT epsilon cycle lost bounded partial output"
			}
			_ => crash "AAT epsilon cycle escaped its operation bound"
		}
	}
	candidate = if bytes.take_first(4) == [0, 1, 0, 0] or bytes.take_first(4) == "OTTO".to_utf8() or bytes.take_first(4) == "ttcf".to_utf8() {
		bytes
	} else {
		seed = match choice % 8 {
			0 => real_file
			1 => matrix_file
			2 => state_file
			3 => cross_file
			4 => anchor_file
			5 => point_file
			6 => chain_file
			_ => cycle_file
		}
		FontBuild.mutate(seed, bytes.drop_first(1))
	}
	match Font.from_bytes(candidate, Font.ReadOptions.{}) {
		Ok(original) => {
			again = ready(candidate)
			for value in [0.Dec, 0.5, 1] {
				settings = Font.Variation.{ axes: [{ tag: "wght", value }] }
				moved = Font.at(original, settings)
				repeated = Font.at(again, settings)
				for direction in [LeftToRight, RightToLeft, TopToBottom, BottomToTop] {
					selected = Font.ShapeOptions.{ script: "Latn", language: "en", direction }
					text = if (choice % 2 == 0) "a\u(0301)bcab" else "abababab"
					result = Font.shape(moved, text, selected)
					if result != Font.shape(repeated, text, selected) {
						crash "AAT output differs across independent reads"
					}
					check(moved, text, selected, result)
				}
			}
		}
		Err(_) => {}
	}
	Fuzz.keep
}

ready : List(U8) -> Font
ready = |bytes| match Font.from_bytes(bytes, Font.ReadOptions.{}) {
	Ok(f) => f
	Err(ps) => crash Str.inspect(ps)
}

check : Font, Str, Font.ShapeOptions, Font.Run -> {}
check = |font, text, options, run| {
	n = run.glyphs.len()
	if n != run.advances.len() or n != run.offsets.len() or n != run.clusters.len() or n != run.flags.len() {
		crash "AAT output lost index alignment"
	}
	var $scalars = 0.U64
	for byte in text.to_utf8() {
		if byte.bitwise_and(192) != 128 {
			$scalars = $scalars + 1
		}
	}
	if n > (65536.U64).max($scalars * 256) {
		crash "AAT output exceeded glyph bound"
	}
	if run.clusters.any(|i| i >= text.to_utf8().len()) {
		crash "AAT output cluster escaped original text"
	}
	if run != Font.shape(font, text, options) {
		crash "AAT output nondeterministic"
	}
	{}
}

target = Fuzz.target_with!({ name: "font-aat-position", generator: Fuzz.raw_bytes, test!, show: |bytes| Str.inspect(bytes.take_first(32)) })
