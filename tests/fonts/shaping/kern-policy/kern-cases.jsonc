{
  "schema": 1,
  "about": "Original valid fonts distinguish script-disabled legacy kern from retained GPOSkern/dist and ordinary Latin/Hangul legacy kerning.",
  "cases": [
    {
      "id": "legacy-only-Latn-46",
      "font": "legacy-only.ttf",
      "text": "..",
      "options": {
        "script": "Latn",
        "direction": "ltr",
        "hb_options": [
          "--show-flags"
        ]
      },
      "expected": "oracle"
    },
