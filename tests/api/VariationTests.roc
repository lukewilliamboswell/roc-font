	[0, 0],
	[
		[-5, -50, 20, 0, 7, 7, 0, -10, 0, 0, 0, 15, 5, 0, 12, 12, -1, -1, 2, 2, -1, 12, 12, -1, -1, 2, 2, -1, 0, 0, 0, 0, 0, 0, 0, -30, -30, -30, -30, -30, -30, 11, -13, -13, -4, -4, -4, -4, 0],
