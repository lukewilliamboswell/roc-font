record_at : Dec, Dec -> (List(I16), I64)
record_at = |wght_value, wdth_value| {
	moved = at(feature_var, [{ tag: "wght", value: wght_value }, { tag: "wdth", value: wdth_value }])
	run = Font.shape(moved, "ab", Font.ShapeOptions.{})
	names = run.glyphs.map(|g| Font.glyph_name(moved, g) ?? "")
	record = match names {
		["a.alt1", "b.alt"] => 0
		["a.alt1", "b"] => 1
		["a", "b.alt"] => 2
		["a.alt2", "b"] => 3
		["a", "b.alt2"] => 4
		["a", "b"] => -1
		_ => -2
	}
	(Font.coordinates(moved).map(|c| c.value), record)
}

expect feature_cases.all(|(w, d, cw, cd, record)| record_at(w, d) == ([cw, cd], record))

# ------------------------------------------------------------ glyph boxes that vary

# `var-outlines.ttf`: simple and composite glyphs (offsets, scales, a 2x2
# transform, anchor points, a nested composite) whose points `gvar` moves,
# with untouched points inferred and phantom points moved.
outlines : Font
outlines = read_or_crash(outlines_file)

Ink : [Extents({ x_min : I32, y_min : I32, x_max : I32, y_max : I32 }), Empty, Unknown]

boxes : Font -> List(Ink)
boxes = |font| [0, 1, 2, 3, 4, 5, 6, 7, 8].map(|g| Font.extents(font, g))

box : I32, I32, I32, I32 -> Ink
box = |x_min, y_min, x_max, y_max| Extents({ x_min, y_min, x_max, y_max })

expect boxes(outlines) == [Empty, box(100, 0, 500, 700), box(80, 0, 480, 820), box(0, -40, 1408, 700), box(0, 60, 720, 1630), box(0, -39, 1867, 775), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, wght(900))) == [Empty, box(95, 0, 525, 740), box(111, 7, 512, 824), box(88, -21, 1460, 740), box(-8, 63, 737, 1671), box(22, -19, 1897, 819), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, wght(100))) == [Empty, box(100, 0, 500, 700), box(80, 0, 480, 820), box(55, -40, 1463, 700), box(0, 60, 720, 1630), box(0, -39, 1867, 775), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, [{ tag: "wght", value: 650 }, { tag: "wdth", value: 125 }])) == [Empty, box(70098, -3, 70513, 717), box(96, 4, 496, 822), box(71, -31, 71063, 717), box(55996, 21058, 56728, 22647), box(36, -24, 71872, 799), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, [{ tag: "wdth", value: 50 }])) == [Empty, box(167, -1000, 400, 1900), box(45, 1, 445, 823), box(-19, -1000, 1469, 1900), box(-186, -820, 580, 2612), box(-45, -1095, 1767, 2095), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]

# The same font's boxes against HarfBuzz's `hb_font_get_glyph_extents`
# (printed by `tests/fonts/variable/oracle.py`). Glyphs: .notdef (empty),
# box, tri (side bearing 80, xMin 50), comp (offset, scale, x and y scale,
# USE_MY_METRICS), comp2 (2x2 transform with scaled offsets, anchor points),
# nest (a composite of comp), space (empty, phantom deltas only), bar and
# bar2 (one large delta on a two-axis scalar).

# The default location: extents come from the glyph headers and `hmtx`.
expect boxes(at(outlines, [])) == [Empty, box(100, 0, 500, 700), box(80, 0, 480, 820), box(0, -40, 1408, 700), box(0, 60, 720, 1630), box(0, -39, 1867, 775), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, [{ tag: "wght", value: 900 }])) == [Empty, box(95, 0, 525, 740), box(111, 7, 512, 824), box(88, -21, 1460, 740), box(-8, 63, 737, 1671), box(22, -19, 1897, 819), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
# No tuple applies, but away from the default the box comes from the
# points: comp takes its left phantom point from box (USE_MY_METRICS), at
# box's xMin less its side bearing (0), so comp's left edge is that of its
# scaled tri component (30 + 0.5 * 50), not comp's side bearing (0).
expect boxes(at(outlines, [{ tag: "wght", value: 100 }])) == [Empty, box(100, 0, 500, 700), box(80, 0, 480, 820), box(55, -40, 1463, 700), box(0, 60, 720, 1630), box(0, -39, 1867, 775), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, [{ tag: "wdth", value: 75 }])) == [Empty, box(167, -1000, 400, 1900), box(45, 1, 445, 823), box(-19, -1000, 1469, 1900), box(-186, -820, 580, 2612), box(-45, -1095, 1767, 2095), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
# The intermediate region at its peak, with a 32-bit delta.
expect boxes(at(outlines, [{ tag: "wght", value: 650 }])) == [Empty, box(70098, -3, 70513, 717), box(96, 4, 496, 822), box(71, -31, 71063, 717), box(55996, 21058, 56728, 22647), box(11, -29, 71882, 794), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, [{ tag: "wght", value: 900 }, { tag: "wdth", value: 75 }])) == [Empty, box(142, -1000, 405, 1940), box(76, 8, 477, 827), box(13, -1000, 1466, 1940), box(-170, -826, 588, 2653), box(-22, -1095, 1777, 2139), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, [{ tag: "wght", value: 400.5 }])) == [Empty, box(245, 0, 645, 700), box(80, 0, 480, 820), box(55, -40, 1462, 700), box(116, 104, 836, 1674), box(0, -39, 2012, 775), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, [{ tag: "wght", value: 812 }, { tag: "wdth", value: 81 }])) == [Empty, box(24861, -761, 24967, 1644), box(79, 7, 480, 826), box(25, -761, 25485, 1644), box(19656, 6804, 20189, 9799), box(-15, -832, 26338, 1813), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, [{ tag: "wght", value: 456.7 }, { tag: "wdth", value: 110.25 }])) == [Empty, box(15976, -1, 16379, 704), box(93, 13, 465, 969), box(63, -32, 16968, 736), box(12700, 4822, 13395, 6533), box(8, -29, 17746, 815), Empty, box(3543, 0, 3643, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, [{ tag: "wght", value: 250 }, { tag: "wdth", value: 120 }])) == [Empty, box(100, 0, 500, 700), box(80, 0, 480, 820), box(55, -40, 1463, 700), box(0, 60, 720, 1630), box(0, -39, 1867, 775), Empty, box(0, 0, 100, 100), box(0, 0, 100, 100)]

# Locations where HarfBuzz's double-precision tuple scalar and a
# single-precision one give different extents: bar's left edge is 1735,
# not 1734, at the first; bar2's (an intermediate region) is 63, not 62,
# at the second.
expect boxes(at(outlines, [{ tag: "wght", value: 417.974853515625 }, { tag: "wdth", value: 115.83099365234375 }])) == [Empty, box(5133, 0, 5534, 701), box(84, 4, 476, 862), box(57, -38, 6130, 701), box(4026, 1570, 4739, 3180), box(3, -36, 6901, 777), Empty, box(1735, 0, 1835, 100), box(0, 0, 100, 100)]
expect boxes(at(outlines, [{ tag: "wght", value: 479.65087890625 }, { tag: "wdth", value: 106.18438720703125 }])) == [Empty, box(22401, -1, 22806, 705), box(93, 12, 469, 947), box(64, -32, 23390, 719), box(17840, 6750, 18541, 8442), box(8, -30, 24173, 796), Empty, box(3003, 0, 3103, 100), box(63, 0, 163, 100)]

# A glyph past the font has no box anywhere.
expect Font.extents(at(outlines, wght(900)), 9) == Empty and Font.extents(at(outlines, wght(900)), 0xFFFFFFFF) == Empty

# ------------------------------------------------------------ instances and coordinates

mapped : Font
mapped = read_or_crash(mapped_file)

# `wght` goes through the font's `avar` map; `wdth` is linear.
expect Font.coordinates(mapped) == [{ tag: "wght", value: 0 }, { tag: "wdth", value: 0 }]
expect Font.coordinates(at(mapped, wght(700))) == [{ tag: "wght", value: 11235 }, { tag: "wdth", value: 0 }]
expect Font.coordinates(at(mapped, [{ tag: "wght", value: 100 }, { tag: "wdth", value: 125 }])) == [{ tag: "wght", value: -16384 }, { tag: "wdth", value: 16384 }]
expect Font.coordinates(at(mapped, wght(456.7))) == [{ tag: "wght", value: 2787 }, { tag: "wdth", value: 0 }]

expect Font.instances(mapped) == [{ name: "Thin", axes: [{ tag: "wght", value: 100 }, { tag: "wdth", value: 100 }] }, { name: "Regular", axes: [{ tag: "wght", value: 400 }, { tag: "wdth", value: 100 }] }, { name: "Bold Condensed", axes: [{ tag: "wght", value: 700 }, { tag: "wdth", value: 75 }] }]

# Moving to an instance is moving to its axis values.
expect {
	bold = Font.instances(mapped).get(2) ?? { name: "", axes: [] }
	Font.coordinates(at(mapped, bold.axes)) == Font.coordinates(at(mapped, [{ tag: "wght", value: 700 }, { tag: "wdth", value: 75 }]))
}

# ------------------------------------------------------------ coordinates and advances

# The fixtures `var-mapped.ttf` (`wght` through an `avar` map, `wdth`
# linear; advances from `HVAR` with an index map), `var-implicit.ttf` (one
# axis, `wght` 300 to 700 with default 300; `HVAR` with implicit glyph
# indices) and `var-format1.ttf` (`wght` and `opsz`; advances from a
# format 1 delta set index map). Every expected coordinate, advance and
# metric is HarfBuzz 14.6.0's (uharfbuzz 0.56.3), printed by
# `tests/fonts/variable/oracle.py`.
implicit : Font
implicit = read_or_crash(implicit_file)

format1 : Font
format1 = read_or_crash(format1_file)

# The normalised coordinates and the advances of glyphs 0 up to `count` at
# a location given by axis values.
located : Font, U32, List({ tag : Str, value : Dec }) -> (List(I16), List(I32))
located = |font, count, axes| {
	moved = at(font, axes)
	var $advances = []
	for g in 0..<count {
		$advances = $advances.append(Font.advance(moved, g))
	}
	(Font.coordinates(moved).map(|c| c.value), $advances)
}

expect located(mapped, 7, []) == ([0, 0], [500, 600, 610, 620, 630, 640, 650])
expect located(mapped, 7, [{ tag: "wght", value: 100 }]) == ([-16384, 0], [500, 500, 711, 620, 630, 639, 649])
expect located(mapped, 7, [{ tag: "wght", value: 250 }]) == ([-10240, 0], [500, 538, 673, 620, 630, 639, 649])
expect located(mapped, 7, [{ tag: "wght", value: 333 }]) == ([-4574, 0], [500, 572, 638, 620, 630, 640, 650])
expect located(mapped, 7, [{ tag: "wght", value: 550 }]) == ([7373, 0], [500, 729, 574, 624, 0, 645, 655])
expect located(mapped, 7, [{ tag: "wght", value: 650 }]) == ([9948, 0], [500, 777, 508, 627, 0, 645, 655])
expect located(mapped, 7, [{ tag: "wght", value: 900 }]) == ([16384, 0], [500, 900, 277, 635, 33397, 641, 651])
# Past the axis maximum: clamped, as the format defines.
expect located(mapped, 7, [{ tag: "wght", value: 1000 }]) == ([16384, 0], [500, 900, 277, 635, 33397, 641, 651])
expect located(mapped, 7, [{ tag: "wght", value: 700 }, { tag: "wdth", value: 75 }]) == ([11235, -16384], [500, 801, 461, 28058, 0, 644, 654])
expect located(mapped, 7, [{ tag: "wght", value: 456.7 }, { tag: "wdth", value: 110.25 }]) == ([2787, 6718], [500, 659, 544, 622, 0, 643, 653])
expect located(mapped, 7, [{ tag: "wdth", value: 125 }]) == ([0, 16384], [500, 625, 482, 620, 630, 643, 653])
expect located(mapped, 7, [{ tag: "wght", value: 812 }, { tag: "wdth", value: 81 }]) == ([14119, -12452], [500, 857, 358, 26830, 0, 642, 652])
# A later value for the same axis wins; an unknown axis is ignored.
expect located(mapped, 7, [{ tag: "wght", value: 100 }, { tag: "opsz", value: 9 }, { tag: "wght", value: 550 }]) == ([7373, 0], [500, 729, 574, 624, 0, 645, 655])

expect located(implicit, 4, [{ tag: "wght", value: 300 }]) == ([0], [500, 600, 700, 800])
expect located(implicit, 4, [{ tag: "wght", value: 350 }]) == ([2048], [500, 608, 695, 806])
expect located(implicit, 4, [{ tag: "wght", value: 401 }]) == ([4137], [500, 616, 690, 813])
expect located(implicit, 4, [{ tag: "wght", value: 500 }]) == ([8192], [500, 644, 677, 811])
expect located(implicit, 4, [{ tag: "wght", value: 700 }]) == ([16384], [500, 700, 650, 807])
expect located(implicit, 4, [{ tag: "wght", value: 200 }]) == ([0], [500, 600, 700, 800])

expect located(format1, 5, [{ tag: "wght", value: 800 }]) == ([16384, 0], [500, 1510, 519, 530, 12885])
expect located(format1, 5, [{ tag: "opsz", value: 48 }]) == ([0, 16384], [500, 10, 521, 530, 0])
expect located(format1, 5, [{ tag: "wght", value: 800 }, { tag: "opsz", value: 48 }]) == ([16384, 16384], [500, 1087, 519, 530, 543])
expect located(format1, 5, [{ tag: "wght", value: 600 }, { tag: "opsz", value: 30 }]) == ([8192, 8192], [500, 779, 520, 530, 541])
expect located(format1, 5, [{ tag: "wght", value: 300 }, { tag: "opsz", value: 10 }]) == ([-8192, -8192], [500, 510, 520, 530, 540])

# `MVAR`: the x height (default 500) and the underline position (default 0).
expect {
	measured = |axes| {
		m = Font.metrics(at(mapped, axes))
		(m.x_height, m.underline.position)
	}
	measured([]) == (500, 0)
		and measured(wght(550)) == (509, -7)
		and measured(wght(650)) == (512, -9)
		and measured(wght(900)) == (520, -15)
		and measured([{ tag: "wght", value: 700 }, { tag: "wdth", value: 75 }]) == (519, -10)
		and measured([{ tag: "wght", value: 456.7 }, { tag: "wdth", value: 110.25 }]) == (499, -1)
		and measured([{ tag: "wdth", value: 125 }]) == (490, 3)
		and measured([{ tag: "wght", value: 812 }, { tag: "wdth", value: 81 }]) == (522, -13)
}
