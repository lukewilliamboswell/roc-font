# ------------------------------------------------------------ substitutions that vary

# `feature-var.ttf`: five `FeatureVariations` records whose condition sets
# use axis ranges, a value from the `GDEF` store and and, or and not, each
# substituting the lookups of `calt` or `liga` (one substitutes both). At
# each location, the coordinates and which record applied, read off the
# glyphs "ab" shapes to, as HarfBuzz gives them (printed by
# `tests/fonts/variable-layout/oracle.py`).
feature_var : Font
feature_var = read_or_crash(feature_file)

