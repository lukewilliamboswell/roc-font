    {
      "id": "input-manual-0-0",
      "font": "../fonts/positioning/context-controls/input-manual.ttf",
      "text": "ab",
      "options": {
        "script": "Latn",
        "hb_options": [
          "--show-flags",
          "--cluster-level=0"
        ]
      },
      "expected": "oracle"
    },
