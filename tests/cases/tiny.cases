# Shaping cases on the crafted fixture tests/cases/fixtures/tiny.ttf: four
# glyphs (.notdef, space, A, V) and a legacy `kern` table with A V = -100.
# Regenerate fixtures with tests/cases/fixtures/generate.py.

# id: kern-table-pair
fixtures/tiny.ttf;--no-glyph-names;U+0041,U+0056;[2=0+550|3=1@-50,0+530]
# id: kern-table-no-pair
fixtures/tiny.ttf;--no-glyph-names;U+0056,U+0041;[3=0+580|2=1+600]
# id: space-and-missing
fixtures/tiny.ttf;--no-glyph-names;U+0041,U+0020,U+0042;[2=0+600|1=1+250|0=2+500]
# id: no-kern-table
fixtures/no-kern.ttf;--no-glyph-names;U+0041,U+0056;[2=0+600|3=1+580]
# id: empty-text
fixtures/tiny.ttf;--no-glyph-names;;[]
