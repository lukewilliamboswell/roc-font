// Shaping cases where roc-font's buffer differs from HarfBuzz's in layout
// but must agree in result. Fonts are in tests/cases/parity/, built by
// FontBuild.rand_fonts (tests/support/FontBuild.roc; tests/api/ParityTests.roc
// checks the committed bytes against it). Glyph g draws U+10000 + g.
//
// `rand` (on by default) picks glyph 1's alternate (20, 21 or 22) and marks
// the whole run unsafe to break. HarfBuzz writes its output over its input
// until a multiple substitution needs room, so whether glyphs already
// output in the same lookup are marked depends on what ran before the
// alternate in that lookup: a ligature, a multiple substitution, both, or
// nothing (and a `liga` lookup before `rand`'s). Runs past 255 glyphs are
// not marked. These cases pin the glyphs and positions; the driver does not
// report flags, so ParityTests.roc checks HarfBuzz 14.6.0's flags for the
// same runs.
{
  "schema": 1,
  "cases": [
    { "id": "rand-plain-1", "font": "parity/rand-plain.ttf", "unicodes": "U+10001", "expected": "[21=0+500]" },
    { "id": "rand-plain-2-3-1", "font": "parity/rand-plain.ttf", "unicodes": "U+10002,U+10003,U+10001", "expected": "[2=0+500|3=1+500|21=2+500]" },
    { "id": "rand-plain-2-3-1-1", "font": "parity/rand-plain.ttf", "unicodes": "U+10002,U+10003,U+10001,U+10001", "expected": "[2=0+500|3=1+500|21=2+500|20=3+500]" },
    { "id": "rand-plain-1-2-3-1-4", "font": "parity/rand-plain.ttf", "unicodes": "U+10001,U+10002,U+10003,U+10001,U+10004", "expected": "[21=0+500|2=1+500|3=2+500|20=3+500|4=4+500]" },
    { "id": "rand-plain-7-8-1-8-7-1", "font": "parity/rand-plain.ttf", "unicodes": "U+10007,U+10008,U+10001,U+10008,U+10007,U+10001", "expected": "[7=0+500|8=1+500|21=2+500|8=3+500|7=4+500|20=5+500]" },
    { "id": "rand-plain-255-glyphs", "font": "parity/rand-plain.ttf", "unicodes": "U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+10002,U+100