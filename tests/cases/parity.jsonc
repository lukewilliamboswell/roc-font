    { "id": "rand-after-ligature-2-3-1", "font": "parity/rand-after-ligature.ttf", "unicodes": "U+10002,U+10003,U+10001", "expected": "[9=0+500|21=2+500]" },
    { "id": "rand-after-ligature-7-2-3-1-8", "font": "parity/rand-after-ligature.ttf", "unicodes": "U+10007,U+10002,U+10003,U+10001,U+10008", "expected": "[7=0+500|9=1+500|21=3+500|8=4+500]" },
