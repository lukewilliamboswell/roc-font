{
  "schema": 1,
  "about": "Real fonts exercising combining marks and existing substitutions/pairs under the full positioning engine.",
  "cases": [
    {
      "id": "inter-0-ltr",
      "font": "../../package/fonts/Inter-Variable.ttf",
      "text": "ạ́ fí ä́",
      "options": {
        "script": "Latn",
        "direction": "ltr"
      },
      "expected": "oracle"
    },
    {
      "id": "inter-0-rtl",
      "font": "../../package/fonts/Inter-Variable.ttf",
      "text": "ạ́ fí ä́",
      "options": {
        "script": "Latn",
        "direction": "rtl"
      },
      "expected": "oracle"
    },
    {
      "id": "inter-1-ltr",
      "font": "../../package/fonts/Inter-Variable.ttf",
      "text": "x̄̇ ỵ́",
      "options": {
        "script": "Latn",
        "direction": "ltr"
      },
      "expected": "oracle"
    },
    {
      "id": "inter-1-rtl",
