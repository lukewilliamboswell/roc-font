// Cases on the pinned corpus fonts (tests/corpus.json; fetch them with
// `scripts/fetch_corpus.py fetch`, otherwise these cases are skipped):
// reading every new entry, Latin, Greek and Cyrillic shaping in Noto Sans
// and Serif, a supplementary-plane emoji through cmap format 12 in Noto
// Emoji (a variable font: `wght` 300-700, default 400), Apple-style legacy
// `kern` tables (Jellee Roman, HarfBuzz's kern-format2 font: no GPOS), and
// fontTools' test fonts, including an `avar` version 2 font roc-font does
// not interpret (docs/variable-fonts.adoc §1).
{
  "schema": 1,
  "cases": [
    // The defaults, committed in package/fonts/ (the same bytes as the corpus entries).
    { "id": "inter-variable-read", "kind": "read", "font": "../../package/fonts/Inter-Variable.ttf", "font_sha256": "4989b125924991b90d05b2d16e0e388c48f7d5bb8b30539bbf9c755278d0ccaf", "expected": "read:accept" },
