import Sfnt
import Bytes
import TablePost
import "../tests/fonts/Inter-Regular-metrics.ttf" as metrics_file : List(U8)
import "fonts/Inter-Variable.ttf" as inter_file : List(U8)
import "fonts/Merriweather-Variable.ttf" as merriweather_file : List(U8)
import "fonts/FiraCode-Variable.ttf" as fira_file : List(U8)
import "../tests/fonts/name-post/mac-roman-v1.ttf" as mac_file : List(U8)
import "../tests/fonts/name-post/ranking-v2.ttf" as ranking_file : List(U8)
import "../tests/fonts/name-post/format1-v25.ttf" as format1_file : List(U8)
import "../tests/fonts/name-post/japanese-v3.ttf" as japanese_file : List(U8)

## The tests of `TablePost`. Test-only: nothing in the package imports this
## module or the fixtures. Run with `roc test package/TablePostTests.roc`.
##
## The fixtures are generated by `tests/fonts/name-post/generate.py`.
## Expected names and metrics of real fonts are fontTools 4.61.1's (the
## `post` table's names behind `getGlyphOrder()`, before fontTools renames
## duplicates and fills in missing names). Across the corpus, the defaults
## and the fixtures, all 27,832 glyph names fontTools reads from version 2.0
## tables agree.
TablePostTests :: {}.{}

# ------------------------------------------------------------ helpers

u16 : U64 -> List(U8)
u16 = |v| [v.shr_zf_wrap(8).bitwise_and(0xFF).to_u8_wrap(), v.bitwise_and(0xFF).to_u8_wrap()]

u32 : U64 -> List(U8)
u32 = |v| u16(v.shr_zf_wrap(16).bitwise_and(0xFFFF)).concat(u16(v.bitwise_and(0xFFFF)))

# A table header of `version`: italic angle -1.5 degrees, underline at -100,
# 50 thick, fixed pitch.
header : U64 -> List(U8)
header = |version| u32(version).concat(u32(0xFFFE8000)).concat(u16(0xFF9C)).concat(u16(50)).concat(u32(1)).concat(List.repeat(0, 16))

# A version 2.0 table: the glyph name indices, then the stored names.
v2 : List(U64), List(Str) -> List(U8)
v2 = |indices, stored| {
	var $out = header(0x00020000).concat(u16(indices.len()))
	for i in indices {
		$out = $out.concat(u16(i))
	}
	for s in stored {
		$out = $out.append(s.to_utf8().len().to_u8_wrap()).concat(s.to_utf8())
	}
	$out
}

# A version 2.5 table with signed offsets.
v25 : List(I64) -> List(U8)
v25 = |offsets| header(0x00025000).concat(u16(offsets.len())).concat(offsets.map(|o| o.to_u64_wrap().bitwise_and(0xFF).to_u8_wrap()))

# Glyph ids 0 up to `n`.
ids : U64 -> List(U32)
ids = |n| {
	var $out = List.with_capacity(n)
	for g in 0..<n {
		$out = $out.append(g.to_u32_wrap())
	}
	$out
}

read : List(U8), U64 -> Try(TablePost, [Rejected])
read = |table, glyph_count| TablePost.read(table, 0, glyph_count).map_err(|_| Rejected)

names : List(U8), U64, U64 -> List(Try(Str, [Missing, Rejected]))
names = |table, glyph_count, upto|
	match TablePost.read(table, 0, glyph_count) {
		Ok(post) => ids(upto).map(|g| TablePost.glyph_name(post, g).map_err(|_| Missing))
		Err(_) => [Err(Rejected)]
	}

problems : List(U8), U64, U64 -> List([BadTable({ table : Str, offset : U32 })])
problems = |table, base, glyph_count|
	match TablePost.read(table, base, glyph_count) {
		Ok(_) => []
		Err(found) => found
	}

bad : U32 -> [BadTable({ table : Str, offset : U32 })]
bad = |offset| BadTable({ table: "post", offset })

from_file : List(U8) -> Try(TablePost, [Absent, Rejected])
from_file = |bytes|
	match Sfnt.directory(bytes) {
		Err(_) => Err(Rejected)
		Ok(tables) => {
			glyph_count = match Sfnt.table(bytes, tables, "maxp", 6) {
				Found(maxp) => Bytes.u16(maxp, 4)
				_ => 0
			}
			match TablePost.from_tables(bytes, tables, glyph_count) {
				Ok(Present(post)) => Ok(post)
				Ok(Absent) => Err(Absent)
				Err(_) => Err(Rejected)
			}
		}
	}

# FNV-1a (64-bit) of every glyph's name followed by a line feed, a glyph
# without a name as `-`; `Rejected` for a table that does not read.
digest : List(U8), U64 -> U64
digest = |bytes, glyph_count|
	match from_file(bytes) {
		Err(_) => 0
		Ok(post) => {
			var $h = 0xcbf29ce484222325
			for g in 0..<glyph_count {
				line = match TablePost.glyph_name(post, g.to_u32_wrap()) {
					Ok(name) => "${name}\n"
					Err(Missing) => "-\n"
				}
				for b in line.to_utf8() {
					$h = $h.bitwise_xor(b.to_u64()).times_wrap(0x100000001b3)
				}
			}
			$h
		}
	}

name_of : List(U8), U32 -> Try(Str, [Missing, Absent, Rejected])
name_of = |bytes, glyph|
	match from_file(bytes) {
		Ok(post) => TablePost.glyph_name(post, glyph).map_err(|_| Missing)
		Err(e) => Err(e)
	}

facts : List(U8) -> Try({ underline : { position : I32, thickness : I32 }, angle : I32, fixed : Bool }, [Absent, Rejected])
facts = |bytes|
	match from_file(bytes) {
		Ok(post) => Ok({ underline: TablePost.underline(post), angle: TablePost.italic_angle(post), fixed: TablePost.fixed_pitch(post) })
		Err(e) => Err(e)
	}

# ------------------------------------------------------------ real fonts

# Every glyph name of the three defaults, against fontTools' digests: 2937,
# 2384 and 2030 glyphs, every one named.
expect digest(inter_file, 2937) == 0xb7b085b99b56c404
expect digest(merriweather_file, 2384) == 0x241538cea64013dd
expect digest(fira_file, 2030) == 0xd2f4f7f08ede18b7

expect name_of(inter_file, 1) == Ok(".null")
expect name_of(inter_file, 1468) == Ok("uni204C")
expect name_of(merriweather_file, 2383) == Ok("cy.i_part.")
expect name_of(fira_file, 1015) == Ok("zero.zero")

# Past the last glyph there is no name.
expect name_of(inter_file, 2937) == Err(Missing)
expect name_of(inter_file, 4294967295) == Err(Missing)

expect facts(inter_file) == Ok({ underline: { position: -348, thickness: 140 }, angle: 0, fixed: Bool.False })
expect facts(merriweather_file) == Ok({ underline: { position: -244, thickness: 60 }, angle: 0, fixed: Bool.False })
expect facts(fira_file) == Ok({ underline: { position: -100, thickness: 50 }, angle: 0, fixed: Bool.True })

# A font without a `post` table reads as absent, not as a problem.
expect facts(metrics_file) == Err(Absent)

# ------------------------------------------------------------ fixtures

# Version 1.0: the first standard names, none past the font's 8 glyphs.
expect name_of(mac_file, 0) == Ok(".notdef")
expect name_of(mac_file, 7) == Ok("dollar")
expect name_of(mac_file, 8) == Err(Missing)
expect facts(mac_file) == Ok({ underline: { position: -150, thickness: 60 }, angle: -819200, fixed: Bool.True })

# Version 2.0: standard and stored names; a byte past ASCII is ISO 8859-1.
expect name_of(ranking_file, 1) == Ok("space")
expect name_of(ranking_file, 3) == Ok("a.alt")
expect name_of(ranking_file, 4) == Ok("caf\u(e9)")
expect name_of(ranking_file, 5) == Ok("uni1F600")
expect facts(ranking_file) == Ok({ underline: { position: -100, thickness: 50 }, angle: 0, fixed: Bool.False })

# Version 2.5 (fontTools cannot read it): .notdef, A, B, space, a.
expect ids(6).map(|g| name_of(format1_file, g)) == [Ok(".notdef"), Ok("A"), Ok("B"), Ok("space"), Ok("a"), Err(Missing)]
expect facts(format1_file) == Ok({ underline: { position: -120, thickness: 40 }, angle: 0, fixed: Bool.False })

# Version 3.0: metrics, no names. 11.25 degrees is 737280 in 16.16.
expect name_of(japanese_file, 0) == Err(Missing)
expect facts(japanese_file) == Ok({ underline: { position: -75, thickness: 25 }, angle: 737280, fixed: Bool.False })

# ------------------------------------------------------------ inline tables

# The header: a negative italic angle and underline position.
expect
	match read(header(0x00030000), 10) {
		Ok(post) => TablePost.italic_angle(post) == -98304 and TablePost.underline(post) == { position: -100, thickness: 50 } and TablePost.fixed_pitch(post)
		Err(_) => Bool.False
	}

# Version 1.0 names the first 258 glyphs only.
expect names(header(0x00010000), 300, 260).drop_first(256) == [Ok("ccaron"), Ok("dcroat"), Err(Missing), Err(Missing)]

# Version 2.0: an empty stored name is no name; glyphs the table does not
# list have no name; entries past the font's glyph count are not read.
expect names(v2([0, 258, 259, 3], ["", "b.alt"]), 6, 6) == [Ok(".notdef"), Err(Missing), Ok("b.alt"), Ok("space"), Err(Missing), Err(Missing)]
expect names(v2([3, 0xFFFF], []), 1, 2) == [Ok("space"), Err(Missing)]

# Stored names nothing refers to, and trailing bytes, are allowed.
expect names(v2([259], ["a", "b", "c"]).concat([0, 0, 7]), 1, 1) == [Ok("b")]

# Version 2.5: positive and negative offsets, up to the last standard name.
expect names(v25([0, 127, -2]), 3, 3) == [Ok(".notdef"), Ok("ucircumflex"), Ok(".notdef")]
expect names(v25(List.repeat(0, 130).append(127)), 131, 131).drop_first(130) == [Ok("dcroat")]

expect
	match read(header(0x00020000).concat(u16(0)), 0) {
		Ok(post) => TablePost.glyph_name(post, 0) == Err(Missing)
		Err(_) => Bool.False
	}

expect TablePost.glyph_name(TablePost.none, 0) == Err(Missing)
expect TablePost.underline(TablePost.none) == { position: 0, thickness: 0 }

# ------------------------------------------------------------ problems

# Too short for the header, and versions this module does not read (4.0,
# 2.0 spelt wrongly). Offsets are in the file (the table is at 500).
expect problems(List.repeat(0, 31), 500, 1) == [bad(500)]
expect problems(header(0x00040000), 500, 1) == [bad(500)]
expect problems(header(0x00000002), 500, 1) == [bad(500)]

# Version 2.0: indices past the end of the table (placed at the count).
expect problems(header(0x00020000).concat(u16(3)).concat(u16(0)), 500, 3) == [bad(532)]

# Version 2.0: a glyph refers to a stored name that is not there (placed
# where the table ran out), or to more names than the table has bytes.
expect problems(v2([258, 260], ["a", "b"]), 500, 2) == [bad(500 + 38 + 4)]
expect problems(v2([258], []).concat([5, 0x41]), 500, 1) == [bad(500 + 36)]
expect problems(v2([0xFFFF], ["a"]), 500, 1) == [bad(500 + 38)]

# A reference past the font's glyph count is never read, so it is no
# problem.
expect problems(v2([0, 0xFFFF], []), 500, 1) == []

# Version 2.5: every offset that selects no standard name is reported, at
# its byte; the count must fit.
expect problems(v25([0, -2, 300 - 256, 0]), 500, 4) == [bad(500 + 35)]
expect problems(v25([-1, 127, 0, 127]), 500, 4) == [bad(500 + 34)]
expect problems(v25([-1].concat(List.repeat(0, 134)).append(127).concat(List.repeat(0, 4))), 0, 140) == [bad(34), bad(34 + 135)]
expect problems(header(0x00025000).concat(u16(5)).concat([0, 0]), 500, 5) == [bad(532)]

# A table that lies outside the file is placed at its offset.
expect {
	tables = [{ tag: Sfnt.tag_of("post"), offset: 40, length: 32 }]
	match TablePost.from_tables(List.repeat(0, 60), tables, 1) {
		Err(found) => found == [bad(40)]
		Ok(_) => Bool.False
	}
}
