	get : U64 -> Property
	get = |cp| {
		var $lo = 0
		var $hi = ShaperIndicData.properties.len()
		var $value = { category: 0, position: 14 }
		while $lo < $hi {
			mid = $lo + ($hi - $lo) // 2
			r = ShaperIndicData.properties.get(mid) ?? { first: 0, last: 0, category: 0, position: 14 }
			if cp < r.first {
				$hi = mid
			}
			else if cp > r.last {
				$lo = mid + 1
			}
			else {
				$value = { category: r.category, position: r.position }
				$lo = $hi
			}
		}
		$value
	}
