## Unicode 18.0.0 Indic properties for the Devanagari block.
## Generated by `tools/ucd/generate_indic.py` from `indic-pins.json`.
## The low four bits hold the syllabic category, the high four its position.
ShaperIndicData :: {}.{

	properties : U32 -> U8
	properties = |cp|
		if cp >= 0x0900 and cp < 0x0980 {
			ShaperIndicData.devanagari.get((cp - 0x0900).to_u64()) ?? 0
		} else {
			match cp {
				0x00A0 => 10
				0x200C => 12
				0x200D => 11
				0x25CC => 10
				_ => 0
			}
		}

