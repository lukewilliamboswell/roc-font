## Unicode 18.0.0 character properties the shaper uses, generated by
## `tools/ucd/generate.py` from the pinned Unicode Character Database
## (`tools/ucd/pins.json`). Do not edit; run the generator.
##
## Internal data for `ShaperUnicode`. Each table is a string of
## fixed-width records of upper-case hexadecimal digits sorted by their
## first field (the expects in `ShaperUnicode` check the order); the generator's
## docstring gives each record's layout.
ShaperUnicodeData :: {}.{

	## Runs of general category: start, then HarfBuzz's category number (4202 records)
	general_categories : List(U8)
	general_categories = "".to_utf8()

	## Runs of canonical combining class: start, then the class (630 records)
	combining_classes : List(U8)
	combining_classes = "".to_utf8()

	## Canonical decompositions, one step: the character, then its first and second parts (000000 for none) (2081 records)
	decompositions : List(U8)
	decompositions = "".to_utf8()

	## Compositions HarfBuzz allows: the first and second characters, then the composite (961 records)
	compositions : List(U8)
	compositions = "".to_utf8()

	## Bidi mirroring glyphs: the character, then its mirror (438 records)
	mirrors : List(U8)
	mirrors = "".to_utf8()

	## Extended_Pictographic ranges: first, then last (156 records)
	pictographic : List(U8)
	pictographic = "".to_utf8()
}
