	scripts = [0x54696274, 0x4D6F6E67, 0x53696E68, 0x42756864, 0x48616E6F, 0x54676C67, 0x54616762, 0x4C696D62, 0x54616C65, 0x42756769, 0x4B686172, 0x53796C6F, 0x54666E67, 0x42616C69, 0x4E6B6F6F, 0x50686167, 0x4368616D, 0x4B616C69, 0x4C657063, 0x526A6E67, 0x53617572, 0x53756E64, 0x45677970, 0x4A617661, 0x4B746869, 0x4D746569, 0x4C616E61, 0x54617674, 0x4261746B, 0x42726168, 0x4D616E64, 0x43616B6D, 0x506C7264, 0x53687264, 0x54616B72, 0x4475706C, 0x4772616E, 0x4B686F6A, 0x53696E64, 0x4D61686A, 0x4D616E69, 0x4D6F6469, 0x486D6E67, 0x50686C70, 0x53696464, 0x54697268, 0x41686F6D, 0x4D756C74, 0x41646C6D, 0x42686B73, 0x4D617263, 0x4E657761, 0x476F6E6D, 0x536F796F, 0x5A616E62, 0x446F6772, 0x476F6E67, 0x526F6867, 0x4D616B61, 0x4D656466, 0x536F676F, 0x536F6764, 0x456C796D, 0x4E616E64, 0x486D6E70, 0x5763686F, 0x43687273, 0x4469616B, 0x4B697473, 0x59657A69, 0x43706D6E, 0x4F756772, 0x546E7361, 0x546F746F, 0x56697468, 0x4B617769, 0x4E61676D, 0x47617261, 0x47756B68, 0x4B726169, 0x4F6E616F, 0x53756E75, 0x546F6472, 0x54757467, 0x42657266, 0x53696474, 0x5461796F, 0x546F6C73, 0x4A757263, 0x5063756E, 0x5365616C]
	joining_scripts : List(U64)
	joining_scripts = [0x41646C6D, 0x41726162, 0x43687273, 0x526F6867, 0x4D616E64, 0x4D616E69, 0x4D6F6E67, 0x4E6B6F6F, 0x4F756772, 0x50686167, 0x50686C70, 0x536F6764, 0x53797263]

	get : U64 -> U64
	get = |cp| {
		var $lo = 0
		var $hi = ShaperUseData.ranges.len()
		var $found = 0
		while $lo < $hi {
			mid = $lo + ($hi - $lo) // 2
			range = ShaperUseData.ranges.get(mid) ?? { first: 0, last: 0, category: 0 }
			if cp < range.first {
				$hi = mid
			}
			else if cp > range.last {
				$lo = mid + 1
			}
			else {
				$found = range.category
				$lo = $hi
			}
		}
		$found
	}
}
