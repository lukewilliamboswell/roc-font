import LayoutVar
import TableVar
import "../tests/fonts/variable-layout/kern-var.ttf" as kern_file : List(U8)
import "../tests/fonts/variable-layout/feature-var.ttf" as feature_file : List(U8)

## The tests of `LayoutVar`. Test-only: nothing in the package imports this
## module or the fixtures. Run with `roc test package/LayoutVarTests.roc`.
##
## The fixtures are generated by `tests/fonts/variable-layout/generate.py`.
## Every expected adjustment, coordinate and matching record below is
## HarfBuzz 14.6.0's (uharfbuzz 0.56.3), printed by
## `tests/fonts/variable-layout/oracle.py`.
LayoutVarTests :: {}.{}

# ------------------------------------------------------------ helpers

wght : U32
wght = 0x77676874

wdth : U32
wdth = 0x77647468

u16 : U64 -> List(U8)
u16 = |v| [v.shr_zf_wrap(8).bitwise_and(0xFF).to_u8_wrap(), v.bitwise_and(0xFF).to_u8_wrap()]

i16 : I64 -> List(U8)
i16 = |v| u16(v.to_u64_wrap().bitwise_and(0xFFFF))

u24 : U64 -> List(U8)
u24 = |v| [v.shr_zf_wrap(16).bitwise_and(0xFF).to_u8_wrap()].concat(u16(v.bitwise_and(0xFFFF)))

u32 : U64 -> List(U8)
u32 = |v| u16(v.shr_zf_wrap(16).bitwise_and(0xFFFF)).concat(u16(v.bitwise_and(0xFFFF)))

be : List(U8), U64, U64 -> U64
be = |bytes, at, len| {
	var $v = 0
	for k in 0..<len {
		$v = $v * 256 + (bytes.get(at + k) ?? 0).to_u64()
	}
	$v
}

# A table's bytes from a font file, or none.
table : List(U8), Str -> List(U8)
table = |font, name| {
	tag = name.to_utf8().fold(0, |acc, b| acc * 256 + b.to_u64())
	count = be(font, 4, 2)
	var $found = []
	for i in 0..<count {
		at = 12 + 16 * i
		if be(font, at, 4) == tag {
			$found = font.sublist({ start: be(font, at + 8, 4), len: be(font, at + 12, 4) })
		}
	}
	$found
}

reasons : List(LayoutVar.Problem) -> List(LayoutVar.Reason)
reasons = |problems| problems.map(|p| p.reason)

# ------------------------------------------------------------ finding pairs

# A value record: its offset, its format and where its device offsets
# count from.
Found : { base : U64, at : U64, format : U64 }

# The coverage index of a glyph, searched linearly (the fixtures are tiny).
coverage_index : List(U8), U64, U64 -> Try(U64, [NotCovered])
coverage_index = |data, at, glyph| {
	count = be(data, at + 2, 2)
	for i in 0..<count {
		if be(data, at, 2) == 1 {
			if be(data, at + 4 + 2 * i, 2) == glyph {
				return Ok(i)
			}
		} else {
			r = at + 4 + 6 * i
			if glyph >= be(data, r, 2) and glyph <= be(data, r + 2, 2) {
				return Ok(be(data, r + 4, 2) + glyph - be(data, r, 2))
			}
		}
	}
	Err(NotCovered)
}

class_of : List(U8), U64, U64 -> U64
class_of = |data, at, glyph| {
	if be(data, at, 2) == 1 {
		start = be(data, at + 2, 2)
		if (glyph >= start and glyph - start < be(data, at + 4, 2)) be(data, at + 6 + 2 * (glyph - start), 2) else 0
	} else {
		var $class = 0
		for i in 0..<be(data, at + 2, 2) {
			r = at + 4 + 6 * i
			if glyph >= be(data, r, 2) and glyph <= be(data, r + 2, 2) {
				$class = be(data, r + 4, 2)
			}
		}
		$class
	}
}

# The pair's value records in one pair adjustment subtable, if it has them.
in_subtable : List(U8), U64, U64, U64 -> Try({ first : Found, second : Found }, [NoPair])
in_subtable = |data, st, left, right| {
	format1 = be(data, st + 4, 2)
	format2 = be(data, st + 6, 2)
	size1 = LayoutVar.value_size(format1)
	size2 = LayoutVar.value_size(format2)
	match coverage_index(data, st + be(data, st + 2, 2), left) {
		Err(NotCovered) => Err(NoPair)
		Ok(index) =>
			if be(data, st, 2) == 1 {
				if index >= be(data, st + 8, 2) {
					return Err(NoPair)
				}
				set = st + be(data, st + 10 + 2 * index, 2)
				record = 2 + size1 + size2
				for p in 0..<be(data, set, 2) {
					r = set + 2 + record * p
					if be(data, r, 2) == right {
						return Ok({ first: { base: set, at: r + 2, format: format1 }, second: { base: set, at: r + 2 + size1, format: format2 } })
					}
				}
				Err(NoPair)
			} else {
				row = class_of(data, st + be(data, st + 8, 2), left)
				column = class_of(data, st + be(data, st + 10, 2), right)
				width = be(data, st + 14, 2)
				if row >= be(data, st + 12, 2) or column >= width {
					Err(NoPair)
				} else {
					r = st + 16 + (size1 + size2) * (row * width + column)
					Ok({ first: { base: st, at: r, format: format1 }, second: { base: st, at: r + size1, format: format2 } })
				}
			}
	}
}

# For each lookup of the `kern` feature, the first subtable with the pair
# decides it, as HarfBuzz and `LayoutKerning` apply a lookup to two glyphs.
pair_records : List(U8), U64, U64 -> List({ first : Found, second : Found })
pair_records = |gpos, left, right| {
	features = be(gpos, 6, 2)
	lookups = be(gpos, 8, 2)
	var $out = []
	for f in 0..<be(gpos, features, 2) {
		record = features + 2 + 6 * f
		if be(gpos, record, 4) == 0x6B65726E {
			feature = features + be(gpos, record + 4, 2)
			for j in 0..<be(gpos, feature + 2, 2) {
				lookup = lookups + be(gpos, lookups + 2 + 2 * be(gpos, feature + 4 + 2 * j, 2), 2)
				kind = be(gpos, lookup, 2)
				var $done = False
				for s in 0..<be(gpos, lookup + 4, 2) {
					at = lookup + be(gpos, lookup + 6 + 2 * s, 2)
					st = if (kind == 9) at + be(gpos, at + 4, 4) else at
					if !$done {
						match in_subtable(gpos, st, left, right) {
							Ok(found) => {
								$out = $out.append(found)
								$done = True
							}
							Err(NoPair) => {}
						}
					}
				}
			}
		}
	}
	$out
}

# The six HarfBuzz columns for a pair: the first glyph's x advance change,
# x offset and y offset, then the second glyph's.
pair_columns : LayoutVar, LayoutVar.Location, List(U8), U64, U64 -> List(I64)
pair_columns = |lv, loc, gpos, left, right| {
	var $out = [0, 0, 0, 0, 0, 0]
	for found in pair_records(gpos, left, right) {
		a = LayoutVar.value(lv, loc, gpos, found.first.base, found.first.at, found.first.format)
		b = LayoutVar.value(lv, loc, gpos, found.second.base, found.second.at, found.second.format)
		# x_advance agrees with value's x advance.
		fast = LayoutVar.x_advance(lv, loc, gpos, found.first.base, found.first.at, found.first.format)
		$out = [
			($out.get(0) ?? 0) + a.x_advance + (fast - a.x_advance) * 1000,
			($out.get(1) ?? 0) + a.x_placement,
			($out.get(2) ?? 0) + a.y_placement,
			($out.get(3) ?? 0) + b.x_advance,
			($out.get(4) ?? 0) + b.x_placement,
			($out.get(5) ?? 0) + b.y_placement,
		]
	}
	$out
}

KernFixture : { space : TableVar, lv : LayoutVar, gpos : List(U8) }

kern_fixture : List(U8) -> Try(KernFixture, [Bad])
kern_fixture = |font| {
	gpos = table(font, "GPOS")
	match TableVar.read(table(font, "fvar"), Absent) {
		Ok(space) =>
			match LayoutVar.read_gdef(table(font, "GDEF"), TableVar.axis_total(space)) {
				Ok(lv) =>
					match LayoutVar.check_gpos(lv, gpos, 8) {
						Ok(45) => Ok({ space, lv, gpos })
						_ => Err(Bad)
					}
				Err(_) => Err(Bad)
			}
		Err(_) => Err(Bad)
	}
}

# Coordinates at a location, and for every ordered pair of glyphs 1-7 the
# six columns, transposed as the oracle prints them.
kern_agrees : List(U8), List({ tag : U32, value : Dec }), List(I16), List(List(I64)) -> Bool
kern_agrees = |font, settings, coords, columns|
	match kern_fixture(font) {
		Ok(f) => {
			got_coords = TableVar.coords_for(f.space, settings)
			loc = LayoutVar.location(f.lv, got_coords)
			var $rows = []
			for left in 1..<8 {
				for right in 1..<8 {
					$rows = $rows.append(pair_columns(f.lv, loc, f.gpos, left, right))
				}
			}
			got = [0, 1, 2, 3, 4, 5].map(|k| $rows.map(|r| r.get(k) ?? 0))
			got_coords == coords and got == columns
		}
		Err(_) => False
	}

