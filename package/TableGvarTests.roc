import TableVar
import TableGlyfPoints
import TableGvar
import "../tests/fonts/variable/var-outlines.ttf" as outlines_file : List(U8)

## The tests of `TableGlyfPoints` and `TableGvar`. Test-only: nothing in
## the package imports this module or the fixture. Run with
## `roc test package/TableGvarTests.roc`.
##
## The fixture is generated by `tests/fonts/variable/generate.py`. Every
## expected extent below is HarfBuzz 14.6.0's (uharfbuzz 0.56.3,
## `hb_font_get_glyph_extents` at a scale of one unit per em unit), printed
## by `tests/fonts/variable/oracle.py`.
TableGvarTests :: {}.{}

# ------------------------------------------------------------ helpers

wght : U32
wght = 0x77676874

wdth : U32
wdth = 0x77647468

u16 : U64 -> List(U8)
u16 = |v| [v.shr_zf_wrap(8).bitwise_and(0xFF).to_u8_wrap(), v.bitwise_and(0xFF).to_u8_wrap()]

i16 : I64 -> List(U8)
i16 = |v| u16(v.to_u64_wrap().bitwise_and(0xFFFF))

u32 : U64 -> List(U8)
u32 = |v| u16(v.shr_zf_wrap(16).bitwise_and(0xFFFF)).concat(u16(v.bitwise_and(0xFFFF)))

be : List(U8), U64, U64 -> U64
be = |bytes, at, len| {
	var $v = 0
	for k in 0..<len {
		$v = $v * 256 + (bytes.get(at + k) ?? 0).to_u64()
	}
	$v
}

# A table's bytes from a font file, or none.
table : List(U8), Str -> List(U8)
table = |font, name| {
	tag = name.to_utf8().fold(0, |acc, b| acc * 256 + b.to_u64())
	count = be(font, 4, 2)
	var $found = []
	for i in 0..<count {
		at = 12 + 16 * i
		if be(font, at, 4) == tag {
			$found = font.sublist({ start: be(font, at + 8, 4), len: be(font, at + 12, 4) })
		}
	}
	$found
}

Fixture : { space : TableVar, glyf : TableGlyfPoints, gvar : TableGvar }

glyph_count : U64
glyph_count = be(table(outlines_file, "maxp"), 4, 2)

long_offsets : Bool
long_offsets = be(table(outlines_file, "head"), 50, 2) == 1

long_metrics : U64
long_metrics = be(table(outlines_file, "hhea"), 34, 2)

read_glyf : List(U8), List(U8) -> Try(TableGlyfPoints, List(TableGlyfPoints.Problem))
read_glyf = |glyf, loca| TableGlyfPoints.read(glyf, loca, long_offsets, glyph_count, table(outlines_file, "hmtx"), long_metrics)

fixture : List(U8) -> Try(Fixture, List(TableGlyfPoints.Problem))
fixture = |font| {
	space = match TableVar.read(table(font, "fvar"), Absent) {
		Ok(s) => s
		Err(_) => return Err([])
	}
	glyf = read_glyf(table(font, "glyf"), table(font, "loca"))?
	gvar = TableGvar.read(table(font, "gvar"), 2, glyf)?
	Ok({ space, glyf, gvar })
}

all_extents : Fixture, List({ tag : U32, value : Dec }) -> List((I64, I64, I64, I64))
all_extents = |f, settings| {
	loc = TableGvar.location(f.gvar, TableVar.coords_for(f.space, settings))
	var $out = []
	for g in 0..<glyph_count {
		e = TableGvar.extents(f.glyf, f.gvar, loc, g)
		$out = $out.append((e.x_bearing, e.y_bearing, e.width, e.height))
	}
	$out
}

agrees : List(U8), List({ tag : U32, value : Dec }), List((I64, I64, I64, I64)) -> Bool
agrees = |font, settings, want|
	match fixture(font) {
		Ok(f) => all_extents(f, settings) == want
		Err(_) => False
	}

# ------------------------------------------------------------ the fixture against HarfBuzz

# Glyphs: .notdef (empty), box, tri (side bearing 80, xMin 50), comp
# (offset, scale, x and y scale, USE_MY_METRICS), comp2 (2x2 transform with
# scaled offsets, anchor points), nest (a composite of comp), space (empty,
# phantom deltas only), bar and bar2 (one large delta on a two-axis scalar).

# The default location: extents come from the glyph headers and `hmtx`.
expect agrees(outlines_file, [], [(0, 0, 0, 0), (100, 700, 400, -700), (80, 820, 400, -820), (0, 700, 1408, -740), (0, 1630, 720, -1570), (0, 775, 1867, -814), (0, 0, 0, 0), (0, 100, 100, -100), (0, 100, 100, -100)])
expect agrees(outlines_file, [{ tag: wght, value: 900 }], [(0, 0, 0, 0), (95, 740, 430, -740), (111, 824, 401, -817), (88, 740, 1372, -761), (-8, 1671, 745, -1608), (22, 819, 1875, -838), (0, 0, 0, 0), (0, 100, 100, -100), (0, 100, 100, -100)])
# No tuple applies, but away from the default the box comes from the
# points: comp takes its left phantom point from box (USE_MY_METRICS), at
# box's xMin less its side bearing (0), so comp's left edge is that of its
# scaled tri component (30 + 0.5 * 50), not comp's side bearing (0).
expect agrees(outlines_file, [{ tag: wght, value: 100 }], [(0, 0, 0, 0), (100, 700, 400, -700), (80, 820, 400, -820), (55, 700, 1408, -740), (0, 1630, 720, -1570), (0, 775, 1867, -814), (0, 0, 0, 0), (0, 100, 100, -100), (0, 100, 100, -100)])
expect agrees(outlines_file, [{ tag: wdth, value: 75 }], [(0, 0, 0, 0), (167, 1900, 233, -2900), (45, 823, 400, -822), (-19, 1900, 1488, -2900), (-186, 2612, 766, -3432), (-45, 2095, 1812, -3190), (0, 0, 0, 0), (0, 100, 100, -100), (0, 100, 100, -100)])
# The intermediate region at its peak, with a 32-bit delta.
expect agrees(outlines_file, [{ tag: wght, value: 650 }], [(0, 0, 0, 0), (70098, 717, 415, -720), (96, 822, 400, -818), (71, 717, 70992, -748), (55996, 22647, 732, -1589), (11, 794, 71871, -823), (0, 0, 0, 0), (0, 100, 100, -100), (0, 100, 100, -100)])
expect agrees(outlines_file, [{ tag: wght, value: 900 }, { tag: wdth, value: 75 }], [(0, 0, 0, 0), (142, 1940, 263, -2940), (76, 827, 401, -819), (13, 1940, 1453, -2940), (-170, 2653, 758, -3479), (-22, 2139, 1799, -3234), (0, 0, 0, 0), (0, 100, 100, -100), (0, 100, 100, -100)])
expect agrees(outlines_file, [{ tag: wght, value: 400.5 }], [(0, 0, 0, 0), (245, 700, 400, -700), (80, 820, 400, -820), (55, 700, 1407, -740), (116, 1674, 720, -1570), (0, 775, 2012, -814), (0, 0, 0, 0), (0, 100, 100, -100), (0, 100, 100, -100)])
expect agrees(outlines_file, [{ tag: wght, value: 812 }, { tag: wdth, value: 81 }], [(0, 0, 0, 0), (24861, 1644, 106, -2405), (79, 826, 401, -819), (25, 1644, 25460, -2405), (19656, 9799, 533, -2995), (-15, 1813, 26353, -2645), (0, 0, 0, 0), (0, 100, 100, -100), (0, 100, 100, -100)])
expect agrees(outlines_file, [{ tag: wght, value: 456.7 }, { tag: wdth, value: 110.25 }], [(0, 0, 0, 0), (15976, 704, 403, -705), (93, 969, 372, -956), (63, 736, 16905, -768), (12700, 6533, 695, -1711), (8, 815, 17738, -844), (0, 0, 0, 0), (3543, 100, 100, -100), (0, 100, 100, -100)])
expect agrees(outlines_file, [{ tag: wght, value: 250 }, { tag: wdth, value: 120 }], [(0, 0, 0, 0), (100, 700, 400, -700), (80, 820, 400, -820), (55, 700, 1408, -740), (0, 1630, 720, -1570), (0, 775, 1867, -814), (0, 0, 0, 0), (0, 100, 100, -100), (0, 100, 100, -100)])

# Locations where HarfBuzz's double-precision tuple scalar and a
# single-precision one give different extents: bar's left edge is 1735,
# not 1734, at the first; bar2's (an intermediate region) is 63, not 62,
# at the second.
expect agrees(outlines_file, [{ tag: wght, value: 417.974853515625 }, { tag: wdth, value: 115.83099365234375 }], [(0, 0, 0, 0), (5133, 701, 401, -701), (84, 862, 392, -858), (57, 701, 6073, -739), (4026, 3180, 713, -1610), (3, 777, 6898, -813), (0, 0, 0, 0), (1735, 100, 100, -100), (0, 100, 100, -100)])
expect agrees(outlines_file, [{ tag: wght, value: 479.65087890625 }, { tag: wdth, value: 106.18438720703125 }], [(0, 0, 0, 0), (22401, 705, 405, -706), (93, 947, 376, -935), (64, 719, 23326, -751), (17840, 8442, 701, -1692), (8, 796, 24165, -826), (0, 0, 0, 0), (3003, 100, 100, -100), (63, 100, 100, -100)])

# A glyph past the font has no extents, at any location.
expect
	match fixture(outlines_file) {
		Ok(f) => {
			loc = TableGvar.location(f.gvar, [16384, 0])
			TableGvar.extents(f.glyf, f.gvar, loc, glyph_count) == { x_bearing: 0, y_bearing: 0, width: 0, height: 0 }
				and TableGvar.extents(f.glyf, f.gvar, TableGvar.location(f.gvar, [0, 0]), 99) == { x_bearing: 0, y_bearing: 0, width: 0, height: 0 }
		}
		Err(_) => False
	}

# Without gvar, a location away from the default still measures the
# points (as HarfBuzz does), so comp is shifted by its left phantom point.
expect
	match read_glyf(table(outlines_file, "glyf"), table(outlines_file, "loca")) {
		Ok(glyf) => {
			loc = TableGvar.location(TableGvar.absent, [100, 0])
			e = TableGvar.extents(glyf, TableGvar.absent, loc, 3)
			e == { x_bearing: 55, y_bearing: 700, width: 1408, height: -740 }
		}
		Err(_) => False
	}

# Simple glyph decoding: tri has two contours of 3 and 5 points.
expect
	match read_glyf(table(outlines_file, "glyf"), table(outlines_file, "loca")) {
		Ok(glyf) => {
			p = TableGlyfPoints.simple_points(glyf, 2)
			p.ends == [False, False, True, False, False, False, False, True]
				and p.xs.map(|x| TableVar.f32_round_half_up(x)) == [50, 450, 250, 120, 200, 300, 380, 250]
				and TableGlyfPoints.point_count(glyf, 3) == 3
				and TableGlyfPoints.kind(glyf, 6) == 0
		}
		Err(_) => False
	}

# ------------------------------------------------------------ hand-built glyf

# The problems of a read, none when it reads. Prepared values have no
# equality, so tests compare problems.
problems_of : Try(a, List(TableGlyfPoints.Problem)) -> List(TableGlyfPoints.Problem)
problems_of = |result|
	match result {
		Ok(_) => []
		Err(problems) => problems
	}

# A simple glyph of on-curve points with 16-bit coordinates.
simple : List((I64, I64)), List(U64) -> List(U8)
simple = |points, ends| {
	xs = points.map(|(x, _)| x)
	ys = points.map(|(_, y)| y)
	var $dx = []
	var $dy = []
	var $px = 0
	var $py = 0
	for (x, y) in points {
		$dx = $dx.concat(i16(x - $px))
		$dy = $dy.concat(i16(y - $py))
		$px = x
		$py = y
	}
	min = |l| l.fold(32767, |a, v| a.min(v))
	max = |l| l.fold(-32768, |a, v| a.max(v))
	head = i16(ends.len().to_i64_wrap()).concat(i16(min(xs))).concat(i16(min(ys))).concat(i16(max(xs))).concat(i16(max(ys)))
	head.concat(ends.join_map(u16)).concat(u16(0)).concat(List.repeat(1.U8, points.len())).concat($dx).concat($dy)
}

# A composite glyph of components (glyph, dx, dy) with 16-bit offsets.
composite : List((U64, I64, I64)) -> List(U8)
composite = |components| {
	n = components.len()
	body = components.map_with_index(
		|(g, dx, dy), k| {
			more = if (k + 1 < n) 0x0020 else 0
			u16(0x0003 + more).concat(u16(g)).concat(i16(dx)).concat(i16(dy))
		},
	)
	i16(-1).concat(i16(0)).concat(i16(0)).concat(i16(0)).concat(i16(0)).concat(body.join_map(|b| b))
}

# glyf and long loca for glyphs, each padded to an even length.
tables_of : List(List(U8)) -> { glyf : List(U8), loca : List(U8) }
tables_of = |glyphs| {
	var $glyf = []
	var $loca = []
	for g in glyphs {
		$loca = $loca.concat(u32($glyf.len()))
		$glyf = $glyf.concat(g)
		if $glyf.len() % 2 == 1 {
			$glyf = $glyf.append(0)
		}
	}
	{ glyf: $glyf, loca: $loca.concat(u32($glyf.len())) }
}

hmtx_of : U64 -> List(U8)
hmtx_of = |count| List.repeat(u16(500).concat(i16(0)), count).join_map(|b| b)

glyf_problems : List(List(U8)) -> List(TableGlyfPoints.Problem)
glyf_problems = |glyphs| {
	t = tables_of(glyphs)
	match TableGlyfPoints.read(t.glyf, t.loca, True, glyphs.len(), hmtx_of(glyphs.len()), glyphs.len()) {
		Ok(_) => []
		Err(problems) => problems
	}
}

square : List(U8)
square = simple([(0, 0), (100, 0), (100, 100), (0, 100)], [3])

expect glyf_problems([[], square, composite([(1, 10, 0), (1, 200, 0)])]) == []

# Independent problems in three glyphs: end points out of order, a
# component naming a glyph past the font, and a glyph too short for its
# header. Offsets are from the start of glyf.
expect
	glyf_problems([square, simple([(0, 0), (1, 1), (2, 2)], [1, 1]), composite([(9, 0, 0)]), [0, 1, 0, 0]])
		== [
			{ table: "glyf", offset: 34 + 12, reason: ContourOrder },
			{ table: "glyf", offset: 34 + 32 + 12, reason: GlyphIndex },
			{ table: "glyf", offset: 34 + 32 + 18, reason: TooShort },
		]

# A composite cycle (1 uses 2, 2 uses 1).
expect glyf_problems([square, composite([(2, 0, 0)]), composite([(1, 0, 0)])]).map(|p| p.reason) == [Cycle]

# A flag repeat running past the last point.
expect {
	repeat = i16(1).concat(List.repeat(0.U8, 8)).concat(u16(1)).concat(u16(0)).concat([0x39, 5])
	glyf_problems([repeat]) == [{ table: "glyf", offset: 14, reason: FlagRepeat }]
}

# OTS refuses a point flag with reserved bit 7 set (the cubic flag), and
# instructions that run past the glyph.
expect {
	cubic = i16(1).concat(List.repeat(0.U8, 8)).concat(u16(0)).concat(u16(0)).concat([0x81, 0, 0])
	short = i16(1).concat(List.repeat(0.U8, 8)).concat(u16(0)).concat(u16(48)).concat([0, 1, 2])
	glyf_problems([cubic]).map(|p| p.reason) == [ReservedFlag] and glyf_problems([short]).map(|p| p.reason) == [Truncated]
}

# Coordinates past the end of the glyph.
expect glyf_problems([square.drop_last(2)]) == [{ table: "glyf", offset: 18, reason: Truncated }]

# loca running backwards, and past glyf.
expect {
	t = tables_of([square, square])
	backwards = u32(0).concat(u32(34)).concat(u32(10))
	past = u32(0).concat(u32(34)).concat(u32(200))
	r1 = TableGlyfPoints.read(t.glyf, backwards, True, 2, hmtx_of(2), 2)
	r2 = TableGlyfPoints.read(t.glyf, past, True, 2, hmtx_of(2), 2)
	problems_of(r1) == [{ table: "loca", offset: 8, reason: OffsetOrder }] and problems_of(r2) == [{ table: "loca", offset: 8, reason: Truncated }]
}

# Nesting deeper than HarfBuzz's 64 levels: glyph k uses glyph k + 1, so
# glyphs 0 and 1 are 66 and 65 levels deep.
expect {
	var $chain = []
	for k in 0..<66 {
		$chain = $chain.append(composite([(k + 1, 0, 0)]))
	}
	glyf_problems($chain.append(square)).map(|p| p.reason) == [TooDeep, TooDeep]
}

# Glyphs that expand to too many components: glyph k uses glyph k + 1
# three times, so glyph 0 visits (3^11 - 1) / 2 glyphs and glyph 1
# (3^10 - 1) / 2, both above 16385.
expect {
	var $levels = []
	for k in 0..<10 {
		$levels = $levels.append(composite([(k + 1, 0, 0), (k + 1, 0, 0), (k + 1, 0, 0)]))
	}
	glyf_problems($levels.append(square)).map(|p| p.reason) == [TooManyComponents, TooManyComponents]
}

# An anchor point past the points before the component.
expect {
	anchored = i16(-1).concat(List.repeat(0.U8, 8)).concat(u16(0x0023)).concat(u16(1)).concat(u16(0)).concat(u16(0)).concat(u16(0x0001)).concat(u16(1)).concat(u16(4)).concat(u16(0))
	glyf_problems([[], square, anchored]) == [{ table: "glyf", offset: 34 + 18 + 4, reason: AnchorPoint }]
}

# ------------------------------------------------------------ hand-built gvar

# A gvar with long offsets over the glyph variation data of each glyph.
gvar_of : U64, List(I64), List(List(U8)) -> List(U8)
gvar_of = |axis_count, shared, datas| {
	count = datas.len()
	shared_at = 20 + 4 * (count + 1)
	data_at = shared_at + 2 * shared.len()
	var $offsets = []
	var $at = 0
	for d in datas {
		$offsets = $offsets.concat(u32($at))
		$at = $at + d.len()
	}
	head = u16(1).concat(u16(0)).concat(u16(axis_count)).concat(u16(shared.len() // axis_count)).concat(u32(shared_at)).concat(u16(count)).concat(u16(1)).concat(u32(data_at))
	head.concat($offsets).concat(u32($at)).concat(shared.join_map(i16)).concat(datas.join_map(|d| d))
}

# Glyphs: empty, square (4 points + 4 phantom points).
small_glyf : {} -> Try(TableGlyfPoints, List(TableGlyfPoints.Problem))
small_glyf = |{}| {
	t = tables_of([[], square])
	TableGlyfPoints.read(t.glyf, t.loca, True, 2, hmtx_of(2), 2)
}

small_gvar : List(U8), U64 -> Try(TableGvar, List(TableGlyfPoints.Problem))
small_gvar = |bytes, axes| TableGvar.read(bytes, axes, small_glyf({})?)

gvar_problems : List(U8) -> List(TableGlyfPoints.Problem)
gvar_problems = |bytes|
	match small_gvar(bytes, 1) {
		Ok(_) => []
		Err(problems) => problems
	}

# One tuple on shared tuple 0, private points 0 and 2, byte deltas.
square_data : List(U8)
square_data = u16(1).concat(u16(8)).concat(u16(10)).concat(u16(0x2000)).concat([2, 1, 0, 2, 1, 10, 20, 1, 30, 40])

expect gvar_problems(gvar_of(1, [16384], [[], square_data])) == []

# The square moves: point 0 by (10, 30), point 2 by (20, 40); points 1
# and 3 are inferred from them (IUP).
expect
	match (small_glyf({}), small_gvar(gvar_of(1, [16384], [[], square_data]), 1)) {
		(Ok(glyf), Ok(gvar)) => {
			loc = TableGvar.location(gvar, [16384])
			p = TableGvar.points(glyf, gvar, loc, 1)
			p.xs.take_first(4).map(TableVar.f32_round_half_up) == [10, 120, 120, 10]
				and p.ys.take_first(4).map(TableVar.f32_round_half_up) == [30, 30, 140, 140]
				and TableGvar.extents(glyf, gvar, loc, 1) == { x_bearing: 10, y_bearing: 140, width: 110, height: -110 }
		}
		_ => False
	}

expect gvar_problems(u16(2).concat(gvar_of(1, [16384], [[], square_data]).drop_first(2))) == [{ table: "gvar", offset: 0, reason: UnsupportedVersion }]
expect problems_of(small_gvar(gvar_of(1, [16384], [[], square_data]), 2)) == [{ table: "gvar", offset: 4, reason: AxisCountMismatch }]
expect gvar_problems(gvar_of(1, [16384], [[], square_data, []])) == [{ table: "gvar", offset: 12, reason: GlyphCountMismatch }]
expect gvar_problems(gvar_of(1, [16384], [[], square_data]).drop_last(1)) == [{ table: "gvar", offset: 28, reason: Truncated }]

# A tuple naming shared tuple 1 of 1; a point number past the glyph's 8
# points; a run of deltas past the point count. Each is its own glyph's
# problem, all reported. The data starts at 34.
expect {
	bad_tuple = u16(1).concat(u16(8)).concat(u16(10)).concat(u16(0x2001)).concat([2, 1, 0, 2, 1, 10, 20, 1, 30, 40])
	bad_point = u16(1).concat(u16(8)).concat(u16(10)).concat(u16(0x2000)).concat([2, 1, 0, 8, 1, 10, 20, 1, 30, 40])
	bad_run = u16(1).concat(u16(8)).concat(u16(6)).concat(u16(0x2000)).concat([2, 1, 0, 2, 0x82, 0])
	glyph = |d| gvar_of(1, [16384], [d, d])
	gvar_problems(glyph(bad_tuple)) == [{ table: "gvar", offset: 34 + 6, reason: TupleIndex }, { table: "gvar", offset: 34 + 18 + 6, reason: TupleIndex }]
		and gvar_problems(gvar_of(1, [16384], [[], bad_point])) == [{ table: "gvar", offset: 34 + 11, reason: PointIndex }]
		and gvar_problems(gvar_of(1, [16384], [[], bad_run])) == [{ table: "gvar", offset: 34 + 12, reason: RunCount }]
}

# Glyph data offsets running backwards.
expect {
	g = gvar_of(1, [16384], [[], square_data])
	backwards = g.take_first(24).concat(u32(18)).concat(u32(4)).concat(g.drop_first(32))
	gvar_problems(backwards) == [{ table: "gvar", offset: 28, reason: OffsetOrder }]
}

# ------------------------------------------------------------ totality and determinism

locations : List(List(I16))
locations = [[16384, 0], [-16384, 16384], [8192, -16384], [5000, -3000], [16384, -16384], [17, 0]]

# Extents are finite and repeatable for every glyph and location.
sane : TableGlyfPoints, TableGvar -> Bool
sane = |glyf, gvar| {
	var $ok = True
	for c in locations {
		loc = TableGvar.location(gvar, c)
		for g in 0..<(glyph_count + 2) {
			e = TableGvar.extents(glyf, gvar, loc, g)
			if e != TableGvar.extents(glyf, gvar, loc, g) or e.width < 0 or e.height > 0 or e.x_bearing.abs() > 0x7FFFFFFF or e.y_bearing.abs() > 0x7FFFFFFF {
				$ok = False
			}
		}
	}
	$ok
}

# Every byte of the fixture's gvar corrupted in turn: reading never
# crashes, a table that does not read names a problem, and one that reads
# gives sane extents.
expect {
	gvar = table(outlines_file, "gvar")
	var $ok = True
	match read_glyf(table(outlines_file, "glyf"), table(outlines_file, "loca")) {
		Ok(glyf) => {
			for at in 0..<gvar.len() {
				broken = gvar.set(at, (gvar.get(at) ?? 0).bitwise_xor(0xA5)) ?? gvar
				match TableGvar.read(broken, 2, glyf) {
					Ok(g) => {
						if !sane(glyf, g) {
							$ok = False
						}
					}
					Err(problems) => {
						if problems.is_empty() {
							$ok = False
						}
					}
				}
			}
			$ok
		}
		Err(_) => False
	}
}

# The same for every byte of glyf and loca, read with the fixture's gvar.
expect {
	glyf = table(outlines_file, "glyf")
	loca = table(outlines_file, "loca")
	var $ok = True
	for at in 0..<(glyf.len() + loca.len()) {
		g = if (at < glyf.len()) glyf.set(at, (glyf.get(at) ?? 0).bitwise_xor(0x5A)) ?? glyf else glyf
		l = if (at >= glyf.len()) loca.set(at - glyf.len(), (loca.get(at - glyf.len()) ?? 0).bitwise_xor(0x5A)) ?? loca else loca
		match read_glyf(g, l) {
			Ok(points) =>
				match TableGvar.read(table(outlines_file, "gvar"), 2, points) {
					Ok(gvar) => {
						if !sane(points, gvar) {
							$ok = False
						}
					}
					Err(problems) => {
						if problems.is_empty() {
							$ok = False
						}
					}
				}
			Err(problems) => {
				if problems.is_empty() {
					$ok = False
				}
			}
		}
	}
	$ok
}

# ------------------------------------------------------------ double precision

# C's (double) 1 / 3 and (double) -2 / 7.
expect TableGvar.f64_ratio(1, 3) == 0x3FD5555555555555
expect TableGvar.f64_ratio(-2, 7) == 0xBFD2492492492492
expect TableGvar.f64_ratio(16384, 16384) == TableGvar.f64_one
# 1/3 * 3 rounds back to exactly 1; 0.1 * 0.1 is 0x3F847AE147AE147C, not
# 0.01 (0x3F847AE147AE147B).
expect TableGvar.f64_mul(TableGvar.f64_ratio(1, 3), TableGvar.f64_ratio(3, 1)) == TableGvar.f64_one
expect TableGvar.f64_mul(TableGvar.f64_ratio(1, 10), TableGvar.f64_ratio(1, 10)) == 0x3F847AE147AE147C
# To single precision with ties to even: 1 + 2^-24 is a tie and goes down,
# 1 + 3 * 2^-24 goes up.
expect TableGvar.f64_to_f32(0x3FF0000010000000) == 0x3F800000
expect TableGvar.f64_to_f32(0x3FF0000030000000) == 0x3F800002
expect TableGvar.f64_to_f32(TableGvar.f64_ratio(1, 3)) == 0x3EAAAAAB
# Subnormal doubles: the smallest one, and halving it to zero.
expect TableGvar.f64_mul(1, TableGvar.f64_ratio(1, 2)) == 0
expect TableGvar.f64_mul(3, TableGvar.f64_ratio(1, 2)) == 2
